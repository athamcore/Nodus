# Nodus API Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=Nodus API
APP_VERSION=0.0.1
DEBUG=true
ENVIRONMENT=development

# API
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database (configure in Phase 2)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nodus
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# Security (configure in Phase 3)
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","exp://localhost:8081"]

# External Services (configure in later phases)
# S3_STORAGE_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=nodus-assets
# S3_REGION=us-east-1

# SPEECH_PROVIDER_API_KEY=your-speech-api-key
# LLM_PROVIDER_API_KEY=your-llm-api-key
# OCR_PROVIDER_API_KEY=your-ocr-api-key
# EMBEDDING_PROVIDER_API_KEY=your-embedding-api-key

# Feature Flags
ENABLE_CLOUD_SYNC=false
ENABLE_AI_PROCESSING=false