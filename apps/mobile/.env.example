# Nodus Mobile Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Authentication (configure in Phase 3)
# EXPO_PUBLIC_AUTH_PROVIDER=custom
# EXPO_PUBLIC_AUTH_CLIENT_ID=your-client-id

# Storage (configure in Phase 9)
# EXPO_PUBLIC_STORAGE_PROVIDER=local

# Feature Flags
EXPO_PUBLIC_ENABLE_CLOUD_SYNC=false
EXPO_PUBLIC_ENABLE_AI_PROCESSING=false

# Development
EXPO_PUBLIC_DEV_MODE=true